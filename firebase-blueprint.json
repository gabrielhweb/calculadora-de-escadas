{
  "entities": {
    "SavedContract": {
      "title": "SavedContract",
      "description": "A contract saved by a user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the contract"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "clientName": {
          "type": "string",
          "description": "Name of the client"
        },
        "totalValue": {
          "type": "number",
          "description": "Total value of the contract"
        },
        "status": {
          "type": "string",
          "enum": ["falta_assinar", "producao", "entregue"],
          "description": "Current status of the contract"
        },
        "contractData": {
          "type": "string",
          "description": "JSON stringified contract data payload"
        },
        "userId": {
          "type": "string",
          "description": "User ID of the contract owner"
        }
      },
      "required": ["id", "createdAt", "clientName", "totalValue", "status", "contractData", "userId"]
    },
    "ProductionOrder": {
      "title": "ProductionOrder",
      "description": "A production order in the queue",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "contractId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "clientName": {
          "type": "string"
        },
        "deliveryDate": {
          "type": "string"
        },
        "downPayment": {
          "type": "number"
        },
        "balanceDue": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["in_queue", "completed"]
        },
        "downPaymentStatus": {
          "type": "string",
          "enum": ["pending", "paid"]
        },
        "balanceStatus": {
          "type": "string",
          "enum": ["pending", "paid"]
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["pix", "card", "hybrid"]
        },
        "pixTiming": {
          "type": "string",
          "enum": ["entry", "delivery"]
        },
        "installments": {
          "type": "number"
        },
        "paidInstallments": {
          "type": "number"
        }
      },
      "required": ["id", "createdAt", "clientName", "deliveryDate", "downPayment", "balanceDue", "status"]
    }
  },
  "firestore": {
    "/contracts/{contractId}": {
      "schema": {
        "$ref": "#/entities/SavedContract"
      },
      "description": "Contracts saved by users"
    },
    "/production_queue/{orderId}": {
      "schema": {
        "$ref": "#/entities/ProductionOrder"
      },
      "description": "Production orders"
    }
  }
}
